// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @db.VarChar(128)
  role        UserRole @default(user)

  username String  @unique @db.VarChar(50)
  email    String? @unique @db.VarChar(320)

  nickname  String? @db.VarChar(100)
  avatarUrl String? @db.Text
  bio       String? @db.Text

  birthday DateTime?
  showAge  Boolean   @default(true)

  lastActiveAt DateTime?

  interests           String[]  @default([])
  interestsMigratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags               UserTag[]
  languages          UserLanguage[]
  localizedNames UserLocalizedName[]
  posts              Post[]
  postVersions       PostVersion[]     @relation("PostVersionAuthor")
  postLikes          PostLike[]
  postBookmarks      PostBookmark[]
  postReports        PostReport[]      @relation("PostReportReporter")
  handledPostReports PostReport[]      @relation("PostReportHandler")
  postComments       PostComment[]
  postEditHistory    PostEditHistory[] @relation("PostEditHistoryEditor")

  @@map("users")
}

model UserTag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  value     String   @db.VarChar(50)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@index([value])
  @@map("user_tags")
}

model UserLanguage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  languageCode String   @db.VarChar(32)
  scriptCode   String   @default("") @db.VarChar(32)
  level        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode, scriptCode])
  @@index([languageCode])
  @@map("user_languages")
}

model UserLocalizedName {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  languageCode String @db.VarChar(32)

  scriptCode String @default("") @db.VarChar(32)

  name String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode, scriptCode])
  @@index([userId])
  @@index([languageCode, scriptCode])

  @@map("user_localized_names")
}

model Post {
  id String @id @default(uuid()) @db.Uuid

  // 迁移期间保留旧 Firestore posts/{docId}。
  // 现有深链、Storage 路径和历史数据回填仍依赖这个兼容 ID。
  firestoreId String? @unique @db.VarChar(128)

  authorId String? @db.Uuid

  category            String? @db.VarChar(100)
  primaryLanguageCode String  @db.VarChar(32)

  likeCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions    PostVersion[]
  images      PostImage[]
  likes       PostLike[]
  bookmarks   PostBookmark[]
  reports     PostReport[]
  comments    PostComment[]
  editHistory PostEditHistory[]

  @@index([authorId])
  @@index([category, createdAt])
  @@index([primaryLanguageCode, createdAt])
  @@map("posts")
}

model PostVersion {
  id String @id @default(uuid()) @db.Uuid

  postId       String  @db.Uuid
  authorId     String? @db.Uuid
  languageCode String  @db.VarChar(32)

  title   String @default("") @db.Text
  content String @default("") @db.Text

  bodyDelta Json

  // original / manual / ai / ai_assisted
  type String @default("original") @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation("PostVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([postId, languageCode])
  @@index([languageCode])
  @@index([authorId])
  @@map("post_versions")
}

model PostImage {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid

  url      String @db.Text
  position Int

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([postId])
  @@map("post_images")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostBookmark {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  postId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
  @@map("post_bookmarks")
}

model PostReport {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  postId String @db.Uuid

  // spam / harassment / hate / sexual / violence /
  // misinformation / copyright / other
  reason String @db.VarChar(32)

  // 用户可选的补充说明。
  details String? @db.Text

  // pending / reviewed / dismissed / actioned
  status String @default("pending") @db.VarChar(32)

  // Latest moderation metadata.
  handledById String?   @db.Uuid
  handledAt   DateTime?
  adminNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("PostReportReporter", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("PostReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  post      Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 同一用户不能重复举报同一帖子。
  @@unique([userId, postId])
  // 我的举报。
  @@index([userId, createdAt])
  // 某篇帖子收到的举报。
  @@index([postId, createdAt])
  // 管理员待处理队列。
  @@index([status, createdAt])
  @@index([handledById, handledAt])
  @@map("post_reports")
}

model PostComment {
  id String @id @default(uuid()) @db.Uuid

  // 迁移旧 Firestore 评论时保存完整来源路径。
  // commentId / replyId 只在各自子集合内唯一，所以不能只保存 doc id。
  firestorePath String? @unique @db.VarChar(512)

  postId   String  @db.Uuid
  authorId String? @db.Uuid
  parentId String? @db.Uuid

  // 保存发布当时的显示名，避免历史评论因为用户改名或用户缺失而失去作者文字。
  authorName String @default("Guest") @db.VarChar(100)

  text     String  @default("") @db.Text
  imageUrl String? @db.Text
  replyTo  String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")

  @@index([postId, parentId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

model PostEditHistory {
  id String @id @default(uuid()) @db.Uuid

  firestorePath String? @unique @db.VarChar(512)

  postId     String  @db.Uuid
  editedById String? @db.Uuid

  languageCode String @db.VarChar(32)
  type         String @default("edit") @db.VarChar(32)

  title   String @default("") @db.Text
  content String @default("") @db.Text

  bodyDelta Json
  imageUrls Json

  editedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  editedBy User? @relation("PostEditHistoryEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([postId, languageCode, editedAt])
  @@index([editedById])
  @@map("post_edit_history")
}
